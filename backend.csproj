<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>78f2e23b-3ad0-4e41-bca4-e46686f56c02</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Communication.Email" Version="1.1.0" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.29.2" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="Google.Apis.Auth" Version="1.76.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.13">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Fijado: Microsoft.Data.SqlClient trae la 9.0.11, con vulnerabilidad conocida. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!-- Sin el binario nativo del broker de MSAL (37 MB, inicio de sesión interactivo en Windows):
         lo trae Microsoft.Data.SqlClient y la API no lo usa (se conecta con cadena de conexión). -->
    <PackageReference Include="Microsoft.Identity.Client.NativeInterop" Version="0.20.6" ExcludeAssets="native" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="backend.Tests\**" />
    <Content Remove="backend.Tests\**" />
    <EmbeddedResource Remove="backend.Tests\**" />
    <None Remove="backend.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Services\Templates\*.html" />
  </ItemGroup>

  <PropertyGroup>
    <WarningsAsErrors>CS0219,CS0168</WarningsAsErrors>
  </PropertyGroup>
</Project>
