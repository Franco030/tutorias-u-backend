<?xml version="1.0" encoding="utf-8"?>
<!--
  Cobertura de código de las pruebas (comando completo en el README, sección Pruebas).
  Excluye el código que genera el compilador (obj/, OpenAPI): no es nuestro y
  bajaba la cifra sin decir nada del código de la API.
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <ExcludeByFile>**/obj/**/*.cs</ExcludeByFile>
          <ExcludeByAttribute>GeneratedCodeAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
